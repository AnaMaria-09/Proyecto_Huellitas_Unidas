{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "esnext",
          "moduleResolution": "bundler"
        }
      }
    ]
  },
  "globalSetup": "<rootDir>/test/soporte/iniciar-servidor.ts",
  "setupFiles": ["<rootDir>/test/soporte/preparar-entorno.ts"],
  "testTimeout": 30000,
  "globalTeardown": "<rootDir>/test/soporte/detener-servidor.ts",
  "maxWorkers": 1
}
