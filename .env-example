# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
# Los valores de abajo son solo de ejemplo para desarrollo local.

# Aplicación
PORT=3000
# development | production | test. synchronize y logging de TypeORM solo se activan en development.
NODE_ENV=development

# PostgreSQL
# Con `npm run start:dev` usa localhost. Dentro de docker compose, la API se conecta al servicio "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=huellitas_unidas
POSTGRES_USER=huellitas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Autenticación
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres

# Observabilidad (opcional). Si faltan, ObserveModule no se registra.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# pgAdmin (opcional, solo con: docker compose --profile herramientas up)
# PGADMIN_EMAIL=admin@huellitas.local
# PGADMIN_PASSWORD=cambia-esta-contrasena

# Almacenamiento (módulo archivos)
