# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
# Los valores de abajo son solo de ejemplo para desarrollo local.

# Aplicación
PORT=3000
# development | production | test. synchronize y logging de TypeORM solo se activan en development.
NODE_ENV=development

# PostgreSQL
# Con `npm run start:dev` usa localhost. Dentro de docker compose, la API se conecta al servicio "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=huellitas_unidas
POSTGRES_USER=huellitas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Autenticación
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
# Duración del access token y del refresh token: un número seguido de s, m, h o d.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS: orígenes permitidos separados por comas (el frontend). Obligatoria.
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Administrador inicial (opcional). Si no existe ningún administrador al arrancar,
# se crea con estos datos. Hay que definir las dos o ninguna; la contraseña, de 8 a 64 caracteres.
# ADMIN_EMAIL=admin@huellitas.local
# ADMIN_PASSWORD=cambia-esta-contrasena

# Observabilidad (opcional). Si faltan, ObserveModule no se registra.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# pgAdmin (opcional, solo con: docker compose --profile herramientas up)
# PGADMIN_EMAIL=admin@huellitas.local
# PGADMIN_PASSWORD=cambia-esta-contrasena

# Almacenamiento (módulo archivos)
# Directorio donde se guardan los archivos subidos (relativo a la raíz del proyecto).
# En docker compose se fija en /app/uploads, montado en un volumen.
ALMACENAMIENTO_DIR=uploads
# Secreto HMAC para firmar las URLs de descarga. Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
URL_FIRMADA_SECRETO=cambia-este-secreto-de-urls-firmadas-por-uno-de-32-o-mas
# Vigencia de una URL firmada, en segundos.
URL_FIRMADA_EXPIRA_SEGUNDOS=300

# Límite de peticiones por minuto e IP (opcionales). Global y para registro e inicio de sesión.
LIMITE_PETICIONES_POR_MINUTO=100
LIMITE_AUTENTICACION_POR_MINUTO=5
