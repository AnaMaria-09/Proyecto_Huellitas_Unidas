# Copia este archivo como .env.test para correr las pruebas e2e (npm run test:e2e).
# Usa su propia base de datos: las pruebas la vacían entre archivos. Nunca subas .env.test.
# Crea la base una vez con: docker compose exec postgres createdb -U huellitas huellitas_unidas_test

# Puerto en el que las pruebas levantan la API (distinto del de desarrollo).
PORT=3100
NODE_ENV=test

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=huellitas_unidas_test
POSTGRES_USER=huellitas
POSTGRES_PASSWORD=cambia-esta-contrasena

JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:4200

# Las pruebas inician sesión con este administrador, que la API crea al arrancar.
ADMIN_EMAIL=admin-e2e@huellitas.local
ADMIN_PASSWORD=cambia-esta-contrasena

ALMACENAMIENTO_DIR=uploads-test
URL_FIRMADA_SECRETO=cambia-este-secreto-de-urls-firmadas-por-uno-de-32-o-mas
URL_FIRMADA_EXPIRA_SEGUNDOS=300

# Las pruebas registran muchos usuarios seguidos: se suben los límites solo aquí.
LIMITE_PETICIONES_POR_MINUTO=10000
LIMITE_AUTENTICACION_POR_MINUTO=10000
